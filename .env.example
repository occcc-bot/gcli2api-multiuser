# Copy to .env. Example values are not actual passwords or OAuth secrets.
# Compose builds this fork, not the upstream image.
HOST=0.0.0.0
PORT=7861
PUBLISHED_PORT=7861
# Mandatory single-process operation; startup rejects values other than 1.
WORKERS=1
PATH_PREFIX=

# Set both independently before starting the service; do not use PASSWORD.
API_PASSWORD=replace-with-your-admin-api-password
PANEL_PASSWORD=replace-with-your-panel-password

# Antigravity only. New OAuth authorization requires BOTH values together.
# No built-in defaults. Without this pair, member OAuth returns a generic 502.
# Existing credentials use their own client_id/client_secret and remain usable.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Container paths: Compose persists both databases in the NEW ./creds directory.
# Old data requires scripts/migrate_legacy.py; do not mount it in place.
CREDENTIALS_DIR=/app/creds
MULTIUSER_DB_PATH=/app/creds/multiuser.sqlite3
# true: administrator API password may use only the administrator credential pool.
# false: disable that legacy API entry; personal keys remain available.
MULTIUSER_ALLOW_LEGACY_API_PASSWORD=true

# No proxy by default. A host-local 127.0.0.1 proxy is not reachable in this container.
PROXY=
OAUTH_PROXY_URL=https://oauth2.googleapis.com
GOOGLEAPIS_PROXY_URL=https://www.googleapis.com
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com

# This migration release supports SQLite only. Nonempty POSTGRESQL_URI is rejected
# by startup preflight, even though upstream supports PostgreSQL.
POSTGRESQL_URI=
# Optional session-cache backend. Redis does not enable multi-process operation.
REDIS_URL=

IP_WHITELIST_ENABLED=false
IP_WHITELIST=
MODEL_REWRITE_ENABLED=false
MODEL_REWRITE_RULES=[]
AUTO_BAN=false
AUTO_BAN_ERROR_CODES=403
RETRY_429_ENABLED=true
RETRY_429_MAX_RETRIES=5
RETRY_429_INTERVAL=1
ANTI_TRUNCATION_MAX_ATTEMPTS=3
LOG_LEVEL=info
ENABLE_LOG=1
