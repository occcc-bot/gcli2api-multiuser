# 复制为 .env；示例内容不是实际密码或客户端密钥。
HOST=0.0.0.0
PORT=7861
PUBLISHED_PORT=7861

API_PASSWORD=replace-with-your-admin-api-password
PANEL_PASSWORD=replace-with-your-panel-password

# Google OAuth 应用配置；由部署者提供，不提交实际值。
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
GEMINICLI_OAUTH_CLIENT_ID=
GEMINICLI_OAUTH_CLIENT_SECRET=

CREDENTIALS_DIR=/app/creds
MULTIUSER_DB_PATH=/app/creds/multiuser.sqlite3
MULTIUSER_ALLOW_LEGACY_API_PASSWORD=true
LOG_LEVEL=info

# 可选代理与上游地址；不使用本地代理时留空。
PROXY=
OAUTH_PROXY_URL=https://oauth2.googleapis.com
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com

# 可选外部凭证后端；账户与归属仍使用上面的 SQLite 数据库。
POSTGRESQL_URI=
MONGODB_URI=
REDIS_URL=
