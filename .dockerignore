# Docker ignore
.venv/
venv/
__pycache__/
*.py[cod]
.git/
.github/
.idea/
.vscode/
.claude/
.pytest_cache/
frontend/node_modules/
# Runtime data must never enter the image, even outside the default directory.
creds/
data/
backups/
legacy_archive/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.pem
*.key
*.p12
*.pfx
.ssh/
id_rsa
id_ed25519
id_ecdsa
id_dsa
.git-credentials
.netrc
*.jks
*.keystore
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
# Allow only source manifests/metadata, not stray credential JSON files.
*.json
**/*.json
!fork-version.json
!frontend/package.json
!frontend/package-lock.json
*.log
log.txt
.env
.env.*
**/.env
**/.env.*
!.env.example
*.bak
*.tmp
coverage.xml
htmlcov/
tests/
